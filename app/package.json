{
  "name": "coroner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply coroner --local",
    "db:migrate:remote": "wrangler d1 migrations apply coroner --remote",
    "deploy": "vite build && wrangler deploy",
    "test:e2e": "node scripts/e2e.mjs",
    "cf-typegen": "wrangler types worker/env.d.ts --env-interface Env"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "hono": "^4.13.8",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@cloudflare/workers-types": "^5.20260922.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
